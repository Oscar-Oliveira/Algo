digraph Fluxograma {
    label="SomaArray";
    labelloc=t;
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];
    rankdir=TB;
    n1 [label="Início", shape=oval];
    n2 [label="Fim", shape=oval];
    n3 [label="n = 5", shape=box];
    n4 [label="soma = 0", shape=box];
    n5 [label="declarar numeros: inteiro", shape=box];
    n6 [label="i de 0 até n - 1", shape=diamond];
    n7 [label="numeros[i] = i + 1 * 10", shape=box];
    n8 [label="soma = soma + numeros[i]", shape=box];
    n9 [label="", shape=point];
    n10 [label="media = soma / n", shape=box];
    n11 [label="", shape=point];
    n12 [label="media > 20", shape=diamond];
    n13 [label="escrever(\"Média alta: \", media)", shape=parallelogram];
    n14 [label="escrever(\"Média baixa: \", media)", shape=parallelogram];
    n1 -> n3;
    n3 -> n4;
    n4 -> n5;
    n5 -> n6;
    n6 -> n7 [label="sim"];
    n7 -> n8;
    n8 -> n6;
    n6 -> n9 [label="não"];
    n9 -> n10;
    n10 -> n12;
    n12 -> n13 [label="sim"];
    n13 -> n11;
    n12 -> n14 [label="não"];
    n14 -> n11;
    n11 -> n2;
}