algoritmo "DemoVisualizador"

funcao fatorial(n:inteiro):inteiro
    se n <= 1 entao
        devolver 1
    senao
        devolver n * fatorial(n - 1)

procedimento trocar(ref a:inteiro, ref b:inteiro)
    temp:inteiro = a
    a = b
    b = temp

inicio
    resultado:inteiro = fatorial(5)
    escrever("5! = ", resultado)

    p:inteiro = 3
    q:inteiro = 9
    trocar(p, q)
    escrever("depois de trocar: p=", p, " q=", q)

    notas:inteiro[3] = {14, 17, 9}
    total:inteiro = 0
    i:inteiro
    para i de 0 ate 2 fazer
        total = total + notas[i]
    escrever("total das notas: ", total)
