algoritmo "TesteEstrutura"

estrutura Ponto
    x:inteiro
    y:inteiro

estrutura Retangulo
    canto:Ponto
    largura:inteiro
    altura:inteiro

funcao area(r:Retangulo):inteiro
    retornar r.largura * r.altura

procedimento deslocar(ref p:Ponto, dx:inteiro, dy:inteiro)
    p.x = p.x + dx
    p.y = p.y + dy

inicio
    p1:Ponto
    p1.x = 3
    p1.y = 4
    escrever("p1 = (", p1.x, ", ", p1.y, ")")

    deslocar(p1, 10, 20)
    escrever("p1 depois de deslocar = (", p1.x, ", ", p1.y, ")")

    r:Retangulo
    r.largura = 5
    r.altura = 6
    r.canto.x = 1
    r.canto.y = 2
    escrever("área do retângulo: ", area(r))
    escrever("canto do retângulo: (", r.canto.x, ", ", r.canto.y, ")")

    pontos:Ponto[3]
    pontos[0].x = 100
    escrever("pontos[0].x = ", pontos[0].x, "  pontos[1].x = ", pontos[1].x)
