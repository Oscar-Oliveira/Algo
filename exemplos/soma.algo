algoritmo "SomaArray"

inicio
    n:inteiro = 5
    soma:inteiro = 0
    numeros:inteiro[10]
    i:inteiro

    para i de 0 ate n - 1 fazer
        numeros[i] = (i + 1) * 10
        soma = soma + numeros[i]

    media:decimal = soma / n

    se media > 20 entao
        escrever("Média alta: ", media)
    senao
        escrever("Média baixa: ", media)
