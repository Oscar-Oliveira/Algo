algoritmo "MatrizEEscolha"

total:inteiro = 0

procedimento acumular(x:inteiro)
    total = total + x

inicio
    matriz:inteiro[3][3]

    para i de 0 ate 2 fazer
        para j de 0 ate 2 fazer
            matriz[i][j] = (i + 1) * (j + 1)
            acumular(matriz[i][j])

    para i de 0 ate 2 fazer
        para j de 0 ate 2 fazer
            escrever(matriz[i][j], " ")

    escrever("Total acumulado: ", total)

    nota:inteiro = 3
    escolher nota
        caso 1
            escrever("Mau")
        caso 2, 3
            escrever("Suficiente")
        caso 4, 5
            escrever("Bom")
        contrario
            escrever("Nota inválida")

    contador:inteiro = 0
    enquanto contador < 3 fazer
        escrever("enquanto: ", contador)
        contador = contador + 1

    contador = 0
    fazer
        escrever("fazer-enquanto: ", contador)
        contador = contador + 1
    enquanto contador < 3
