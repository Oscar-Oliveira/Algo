algoritmo "Avancado"

estrutura Ponto
    x:inteiro
    y:inteiro

inicio
    // literal de estrutura: inicialização direta com {campo: valor, ...}
    origem:Ponto = {x: 0, y: 0}
    p:Ponto = {x: 3, y: 4}
    escrever("p = (", p.x, ", ", p.y, ")")
    escrever("distância a origem em x: ", p.x - origem.x)

    // inicialização parcial: campos omitidos ficam com o valor por omissão
    so_x:Ponto = {x: 10}
    escrever("so_x = (", so_x.x, ", ", so_x.y, ")")

    // arrays podem ter mais de 2 dimensões
    cubo:inteiro[2][2][2]
    para i de 0 ate 1 fazer
        para j de 0 ate 1 fazer
            para k de 0 ate 1 fazer
                cubo[i][j][k] = i * 100 + j * 10 + k

    escrever("cubo[0][0][0] = ", cubo[0][0][0])
    escrever("cubo[1][1][1] = ", cubo[1][1][1])

    // literais de array também funcionam com 3 dimensões
    c2:inteiro[2][2][2] = {{{1, 2}, {3, 4}}, {{5, 6}, {7, 8}}}
    escrever("c2[1][0][1] = ", c2[1][0][1])
