algoritmo "TarifaTaxi"

funcao calcularTarifa(distancia:decimal, horaPonta:booleano):decimal
    tarifa:decimal = 3.5 + 0.8 * distancia
    se horaPonta entao
        tarifa = tarifa * 1.2
    retornar tarifa

inicio
    distanciaViagem:decimal
    escrever("Distância (km): ")
    ler(distanciaViagem)

    ehHoraPonta:booleano
    escrever("É hora de ponta (verdadeiro/falso): ")
    ler(ehHoraPonta)

    escrever("Tarifa: ", calcularTarifa(distanciaViagem, ehHoraPonta))
