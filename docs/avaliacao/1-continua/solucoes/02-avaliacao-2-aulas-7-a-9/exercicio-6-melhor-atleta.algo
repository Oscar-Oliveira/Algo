algoritmo "MelhorAtleta"

estrutura Atleta
    nome:cadeia
    pontuacao:decimal

funcao encontrarMelhor(atletas:Atleta[], tamanho:inteiro):cadeia
    melhorIndice:inteiro = 0
    i:inteiro
    para i de 0 ate tamanho - 1 fazer
        se atletas[i].pontuacao > atletas[melhorIndice].pontuacao entao
            melhorIndice = i
    retornar atletas[melhorIndice].nome

inicio
    equipa:Atleta[4]
    i:inteiro
    para i de 0 ate 3 fazer
        equipa[i] = {}
        escrever("Nome do atleta ", i + 1, ": ")
        ler(equipa[i].nome)
        escrever("Pontuação: ")
        ler(equipa[i].pontuacao)

    escrever("Melhor atleta: ", encontrarMelhor(equipa, 4))
