algoritmo "MapaLugaresCinema"

inicio
    lugares:caracter[2][4] = {{'L', 'L', 'O', 'L'}, {'O', 'L', 'L', 'O'}}
    livres:inteiro = 0
    i:inteiro
    j:inteiro
    para i de 0 ate 1 fazer
        para j de 0 ate 3 fazer
            se lugares[i][j] == 'L' entao
                livres = livres + 1

    escrever("Lugares livres: ", livres)
