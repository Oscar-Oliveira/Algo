digraph Para {
    rankdir=TB;
    bgcolor="transparent";
    node [fontname="Segoe UI,Arial", fontsize=18, style=filled];
    edge [fontname="Segoe UI,Arial", fontsize=14, color="#555555"];

    inicio [shape=ellipse, label="Início", fillcolor="#e8f5e9", color="#66bb6a"];
    init   [shape=box, label="i = de\n(1)", fillcolor="#e3f2fd", color="#42a5f5"];
    corpo  [shape=box, label="corpo do ciclo\nescrever(i)", fillcolor="#e3f2fd", color="#42a5f5"];
    cond   [shape=diamond, label="i + passo <= ate ?", fillcolor="#fff8e1", color="#f9a825"];
    incr   [shape=box, label="i = i + passo\n(+1)", fillcolor="#e3f2fd", color="#42a5f5"];
    fim    [shape=ellipse, label="Fim\n(i mantém o valor\nque já tinha: 5)", fillcolor="#ffebee", color="#ef5350"];

    inicio -> init -> corpo -> cond;
    cond -> incr [label="verdadeiro"];
    incr -> corpo;
    cond -> fim [label="falso"];
}
