digraph Enquanto {
    rankdir=TB;
    bgcolor="transparent";
    node [fontname="Segoe UI,Arial", fontsize=18, style=filled];
    edge [fontname="Segoe UI,Arial", fontsize=14, color="#555555"];

    inicio [shape=ellipse, label="Início", fillcolor="#e8f5e9", color="#66bb6a"];
    cond   [shape=diamond, label="n > 0 ?", fillcolor="#fff8e1", color="#f9a825"];
    corpo  [shape=box, label="escrever(n)\nn = n - 1", fillcolor="#e3f2fd", color="#42a5f5"];
    fim    [shape=ellipse, label="Fim", fillcolor="#ffebee", color="#ef5350"];

    inicio -> cond;
    cond -> corpo [label="verdadeiro"];
    corpo -> cond;
    cond -> fim [label="falso"];
}
