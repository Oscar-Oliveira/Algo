algoritmo "ListaLigadaFixa"

// Uma lista ligada de tamanho fixo, construída de trás para a frente.
// Foco: campo de uma estrutura do PRÓPRIO tipo ('seguinte:No'),
// comparação com 'nulo', e o idioma clássico de percurso
// 'enquanto no <> nulo fazer'. 'estrutura' é um tipo por referência
// (7.3 do manual): uma declaração sem literal '={...}' fica 'nulo',
// por isso cada nó é construído já com um literal, com 'seguinte' a
// apontar para o nó seguinte (já construído antes dele).

estrutura No
    valor:inteiro
    seguinte:No

inicio
    terceiro:No = {valor: 30, seguinte: nulo}
    segundo:No = {valor: 20, seguinte: terceiro}
    primeiro:No = {valor: 10, seguinte: segundo}

    atual:No = primeiro
    soma:inteiro = 0
    contagem:inteiro = 0
    enquanto atual <> nulo fazer
        escrever("Nó: ", atual.valor)
        soma = soma + atual.valor
        contagem = contagem + 1
        atual = atual.seguinte

    escrever("Soma dos ", contagem, " nós: ", soma)
