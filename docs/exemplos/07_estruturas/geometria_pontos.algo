algoritmo "GeometriaDePontos"

// Pontos, segmentos, e distância entre pontos.
// Foco: estrutura aninhada dentro de outra (Segmento contém dois Ponto),
// estrutura sempre aliasada como parâmetro -- deslocar muta um campo do
// Ponto do chamador SEM 'ref'; só reatribuir o parâmetro a outra
// instância (reiniciar) precisa de 'ref' para propagar. 'matematica.raiz'
// só chega no assunto 08, por isso a raiz quadrada é aproximada aqui à
// mão (método de Newton), reaproveitando 'para' (assunto 04).

estrutura Ponto
    x:decimal
    y:decimal

estrutura Segmento
    origem:Ponto
    destino:Ponto

funcao raizAproximada(valor:decimal):decimal
    se valor == 0.0 entao
        retornar 0.0
    estimativa:decimal = valor
    i:inteiro
    para i de 1 ate 20 fazer
        estimativa = (estimativa + valor / estimativa) / 2.0
    retornar estimativa

funcao distancia(p1:Ponto, p2:Ponto):decimal
    dx:decimal = p1.x - p2.x
    dy:decimal = p1.y - p2.y
    retornar raizAproximada(dx * dx + dy * dy)

funcao comprimentoSegmento(s:Segmento):decimal
    retornar distancia(s.origem, s.destino)

procedimento deslocar(p:Ponto, dx:decimal, dy:decimal)
    p.x = p.x + dx
    p.y = p.y + dy

procedimento reiniciar(ref p:Ponto)
    p = {x: 0.0, y: 0.0}

inicio
    a:Ponto = {}
    a.x = 0.0
    a.y = 0.0

    b:Ponto = {}
    b.x = 3.0
    b.y = 4.0

    escrever("Distância entre a e b: ", distancia(a, b))

    deslocar(a, 10.0, 10.0)
    escrever("a depois de deslocar (sem 'ref', mutar um campo já propaga): (", a.x, ", ", a.y, ")")
    escrever("b não foi afetado por deslocar 'a': (", b.x, ", ", b.y, ")")

    reiniciar(a)
    escrever("a depois de reiniciar (só com 'ref' a reatribuição propaga): (", a.x, ", ", a.y, ")")

    segmento:Segmento = {}
    segmento.origem = a
    segmento.destino = b
    escrever("Comprimento do segmento origem-destino: ", comprimentoSegmento(segmento))
