algoritmo "PrincipalGeometria"

// Foco: 'incluir ... como' -- as funções do ficheiro incluído só ficam
// acessíveis com o prefixo do alias; a 'constante' global continua sem
// prefixo, com qualquer alias.

incluir "biblioteca_geometria.algo" como geo

inicio
    raio:decimal
    escrever("Raio do círculo: ")
    ler(raio)

    escrever("PI (definido na biblioteca incluída): ", PI)
    escrever("Área do círculo: ", geo.areaCirculo(raio))
    escrever("Perímetro do círculo: ", geo.perimetroCirculo(raio))

    largura:decimal
    escrever("Largura do retângulo: ")
    ler(largura)
    altura:decimal
    escrever("Altura do retângulo: ")
    ler(altura)
    escrever("Área do retângulo: ", geo.areaRetangulo(largura, altura))
