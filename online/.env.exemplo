# Copia este ficheiro para ".env" (sem o ".exemplo") e preenche os dois
# valores antes de correres `docker compose up`. NUNCA versiones o
# ".env" real -- só este modelo.
#
# Gerar as duas chaves (uma vez só, guardar em segurança):
#   python3 -c "from cifragem import gerar_chave_nova; print(gerar_chave_nova())"
#   python3 -c "import secrets; print(secrets.token_hex(32))"

ONLINE_CHAVE_CIFRAGEM=preenche-aqui-a-chave-gerada-com-gerar_chave_nova
ONLINE_CHAVE_SESSAO=preenche-aqui-a-segunda-chave-gerada-com-secrets.token_hex

# Opcional -- só é preciso se quiseres restringir quem se pode registar.
# Lista de emails (separados por vírgula) que se tornam administradores
# automaticamente -- só eles podem aprovar novas contas em /admin. Se
# ficar por preencher, o registo continua aberto (como hoje): qualquer
# conta nova fica logo aprovada, sem precisar de aprovação nenhuma.
ONLINE_EMAIL_ADMIN=

# Credenciais do serviço 'bd' (PostgreSQL) definido em docker-compose.yml
# -- escolhe um utilizador/password próprios deste deployment, nunca os
# valores de exemplo abaixo. O docker-compose.yml monta-os automaticamente
# em ONLINE_DATABASE_URL, não precisas de repetir aqui.
POSTGRES_USER=algo_online
POSTGRES_PASSWORD=preenche-aqui-uma-password-forte
POSTGRES_DB=algo_online
