algoritmo "MaiorMenorVetor"

inicio
    n:inteiro
    escrever("Quantos números? ")
    ler(n)

    v:inteiro[n]
    i:inteiro
    para i de 0 ate n - 1 fazer
        escrever("Número: ")
        ler(v[i])

    maior:inteiro = v[0]
    menor:inteiro = v[0]
    para i de 0 ate n - 1 fazer
        se v[i] > maior entao
            maior = v[i]
        se v[i] < menor entao
            menor = v[i]

    escrever("Maior: ", maior)
    escrever("Menor: ", menor)
