algoritmo "RankingJogadores"

estrutura Jogador
    nome:cadeia
    pontuacao:inteiro

inicio
    n:inteiro
    escrever("Quantos jogadores? ")
    ler(n)

    jogadores:Jogador[n]
    i:inteiro
    para i de 0 ate n - 1 fazer
        escrever("Nome: ")
        ler(jogadores[i].nome)
        escrever("Pontuação: ")
        ler(jogadores[i].pontuacao)

    j:inteiro
    para i de 0 ate n - 2 fazer
        para j de 0 ate n - 2 - i fazer
            se jogadores[j].pontuacao < jogadores[j + 1].pontuacao entao
                temp:Jogador = jogadores[j]
                jogadores[j] = jogadores[j + 1]
                jogadores[j + 1] = temp

    escrever("-- Ranking --")
    para i de 0 ate n - 1 fazer
        escrever(i + 1, ". ", jogadores[i].nome, " -- ", jogadores[i].pontuacao, " pontos")
