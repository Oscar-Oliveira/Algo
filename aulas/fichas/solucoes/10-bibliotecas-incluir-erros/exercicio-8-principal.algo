algoritmo "CalculadoraDeFormas"

incluir "exercicio-8-biblioteca_formas.algo" como calc

estrutura Forma
    tipo:cadeia
    area:decimal

inicio
    formas:Forma[2]

    raioCirculo:decimal
    escrever("Raio do círculo: ")
    ler(raioCirculo)
    formas[0] = {tipo: "Círculo", area: calc.areaCirculo(raioCirculo)}

    baseRetangulo:decimal
    alturaRetangulo:decimal
    escrever("Base do retângulo: ")
    ler(baseRetangulo)
    escrever("Altura do retângulo: ")
    ler(alturaRetangulo)
    formas[1] = {tipo: "Retângulo", area: calc.areaRetangulo(baseRetangulo, alturaRetangulo)}

    i:inteiro
    para i de 0 ate 1 fazer
        escrever(formas[i].tipo, ": ", formas[i].area)
