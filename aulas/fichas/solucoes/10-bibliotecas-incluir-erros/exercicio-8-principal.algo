algoritmo "CalculadoraDeFormas"

incluir "exercicio-8-biblioteca_formas.algo" como calc

estrutura Forma
    tipo:cadeia
    area:decimal

inicio
    formas:Forma[2]

    raio:decimal
    escrever("Raio do círculo: ")
    ler(raio)
    formas[0] = {tipo: "Círculo", area: calc.areaCirculo(raio)}

    base:decimal
    altura:decimal
    escrever("Base do retângulo: ")
    ler(base)
    escrever("Altura do retângulo: ")
    ler(altura)
    formas[1] = {tipo: "Retângulo", area: calc.areaRetangulo(base, altura)}

    i:inteiro
    para i de 0 ate 1 fazer
        escrever(formas[i].tipo, ": ", formas[i].area)
