algoritmo "MediaAlunosEstrutura"

estrutura Aluno
    nome:cadeia
    nota:decimal

inicio
    n:inteiro
    escrever("Quantos alunos? ")
    ler(n)

    alunos:Aluno[n]
    i:inteiro
    para i de 0 ate n - 1 fazer
        alunos[i] = {}
        escrever("Nome: ")
        ler(alunos[i].nome)
        escrever("Nota: ")
        ler(alunos[i].nota)

    soma:decimal = 0.0
    para i de 0 ate n - 1 fazer
        soma = soma + alunos[i].nota

    escrever("Média da turma: ", soma / n)
