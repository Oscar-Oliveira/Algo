algoritmo "RenomearPessoa"

estrutura Pessoa
    nome:cadeia
    idade:inteiro

procedimento renomear(pessoa:Pessoa, novoNome:cadeia)
    pessoa.nome = novoNome

inicio
    p:Pessoa = {nome: "Ana", idade: 20}
    escrever("Antes: ", p.nome)
    renomear(p, "Ana Silva")
    escrever("Depois: ", p.nome)
