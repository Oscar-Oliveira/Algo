algoritmo "VerificadorConflitosHorario"

estrutura Reserva
    nome:cadeia
    horaInicio:inteiro
    horaFim:inteiro

funcao haConflito(a:Reserva, b:Reserva):booleano
    retornar a.horaInicio < b.horaFim e b.horaInicio < a.horaFim

inicio
    n:inteiro
    escrever("Quantas reservas? ")
    ler(n)

    reservas:Reserva[n]
    i:inteiro
    para i de 0 ate n - 1 fazer
        escrever("Nome: ")
        ler(reservas[i].nome)
        escrever("Hora de início: ")
        ler(reservas[i].horaInicio)
        escrever("Hora de fim: ")
        ler(reservas[i].horaFim)

    j:inteiro
    encontrouConflito:booleano = falso
    para i de 0 ate n - 2 fazer
        para j de i + 1 ate n - 1 fazer
            se haConflito(reservas[i], reservas[j]) entao
                escrever("Conflito entre ", reservas[i].nome, " e ", reservas[j].nome)
                encontrouConflito = verdadeiro

    se nao encontrouConflito entao
        escrever("Sem conflitos.")
