algoritmo "ContarPares"

inicio
    n:inteiro
    escrever("Quantos números? ")
    ler(n)

    v:inteiro[n]
    i:inteiro
    para i de 0 ate n - 1 fazer
        escrever("Número: ")
        ler(v[i])

    contagem:inteiro = 0
    para i de 0 ate n - 1 fazer
        se v[i] mod 2 == 0 entao
            contagem = contagem + 1

    escrever("Pares: ", contagem)
