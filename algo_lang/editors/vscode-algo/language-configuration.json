{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "/*", "close": "*/", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(estrutura\\b.*|funcao\\b.*|procedimento\\b.*|inicio|se\\b.*\\bentao|senao(\\s+se\\b.*\\bentao)?|para\\b.*\\bfazer|enquanto\\b.*\\bfazer|fazer|escolher\\b.*|caso\\b.*|contrario)\\s*(//.*|/\\*.*\\*/\\s*)?$",
    "decreaseIndentPattern": "^\\s*(senao|caso|contrario)\\b"
  }
}
